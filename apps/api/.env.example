# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# URL publique du serveur : c'est elle qui compose les liens M3U/EPG collés
# dans la TV. En LAN, mets l'IP de la machine (ex. http://192.168.1.20:3000).
PUBLIC_URL=http://localhost:3000

# Clé d'administration (header `x-api-key`). Vide = API ouverte : à ne faire
# qu'en local. Génère-la avec : openssl rand -hex 24
ADMIN_API_KEY=

# ─── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://iptv:iptv@localhost:5433/iptv?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=iptv:
CACHE_TTL=900

# ─── Import iptv-org ──────────────────────────────────────────────────────────
IPTV_ORG_API_URL=https://iptv-org.github.io/api
IPTV_ORG_PLAYLIST_URL=https://iptv-org.github.io/iptv
IMPORT_CRON=0 3 * * *
HEALTH_CRON=0 */6 * * *
IMPORT_ON_BOOT=true
IMPORT_EXCLUDE_NSFW=true
HTTP_TIMEOUT_MS=60000

# Restreindre le catalogue à l'import (vide = tout iptv-org, ~40 000 chaînes).
# Pour une install francophone légère :
# IMPORT_COUNTRIES=FR,CI,BE,CH,CA,SN,ML,BF,CM,CD,TG,BJ,NE,GA,MC
# IMPORT_LANGUAGES=fra
IMPORT_COUNTRIES=
IMPORT_LANGUAGES=

# ─── Vérification des flux ────────────────────────────────────────────────────
HEALTH_CONCURRENCY=20
HEALTH_TIMEOUT_MS=8000
HEALTH_MAX_FAILURES=3
HEALTH_DELETE_AFTER_FAILURES=10

# ─── EPG ──────────────────────────────────────────────────────────────────────
# iptv-org ne publie plus de guides XMLTV prêts à l'emploi. Renseigne ici une ou
# plusieurs URL XMLTV que tu es autorisé à consommer (ex. ta propre instance de
# https://github.com/iptv-org/epg). Vide = guide réduit aux définitions de chaînes.
EPG_SOURCES=
EPG_TTL=21600
